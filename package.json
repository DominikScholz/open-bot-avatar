{
  "name": "alphabet-avatar-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "validate": "node packages/core/scripts/avatar-validate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "fit-curve": "^0.2.0"
  }
}
